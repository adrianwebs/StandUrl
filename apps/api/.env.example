# ==============================================================================
# StandUrl API — Variables de Entorno (.env)
# Ubicación en servidor: /docker/clientes/standurl/api/.env
# ==============================================================================

# ── 1. Imagen y Dominios (Docker Compose & Traefik) ───────────────────────────
API_IMAGE=ghcr.io/adrianwebs/standurl-api:latest
API_DOMAIN=api.standurl.com
DOMAIN=standurl.com
ACME_EMAIL=tu@email.com

# ── 2. Base de Datos (SQL Server) & Redis ─────────────────────────────────────
# Host de BD en producción: 51.195.47.36
DEFAULT_CONNECTION=Server=51.195.47.36;initial catalog=StandUrlProd;persist security info=True;user id=sa;password=0D'1YQgpFHmYCQ!`ibHY;multipleactiveresultsets=True;application name=EntityFramework;Encrypt=false;
REDIS_CONNECTION=redis:6379

# ── 3. Autenticación JWT ──────────────────────────────────────────────────────
# Clave secreta robusta (mínimo 32-64 caracteres aleatorios)
JWT_SECRET=super_secret_jwt_key_cambiar_por_un_hash_largo_y_seguro_min_64_chars!!
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30
JWT_ISSUER=standurl-api
JWT_AUDIENCE=standurl-web

# ── 4. CORS & URLs de la Aplicación ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://standurl.com
APP_SITE_URL=https://standurl.com

# ── 5. Configuración de Correo SMTP (MailKit / OVH) ───────────────────────────
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=adrian@webadir.es
SMTP_PASSWORD=tu_password_de_correo
SMTP_FROM_EMAIL=adrian@webadir.es
SMTP_FROM_NAME=StandUrl
NOTIFICATION_EMAIL=dev@standurl.com
